# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# IP Geolocation API (https://ipgeolocation.io) — optional; without it /api/geo-ip falls back to ip-api
# IPGEOLOCATION_API_KEY=

# Google OAuth (sign-in on frontend) — callback URL must match Google Cloud console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# GetStream (Stream Video) — server-only; copy API key + secret from GetStream dashboard
STREAM_API_KEY=
STREAM_API_SECRET=
# Optional JWT lifetime for POST /api/stream/token (seconds; default 3600)
# STREAM_TOKEN_VALIDITY_SECONDS=3600

# Phase 4–5: browser React SDK needs the public Stream API key (same value as STREAM_API_KEY; not a secret).
NEXT_PUBLIC_STREAM_API_KEY=

# Stream Chat (livestream comments replacement)
STREAM_CHAT_ENABLED=false
STREAM_CHAT_API_KEY=
STREAM_CHAT_API_SECRET=
# Optional separate webhook signing secret; defaults to STREAM_CHAT_API_SECRET when omitted
# STREAM_CHAT_WEBHOOK_SECRET=

# Media storage provider
# - local: disable cloud plugin and store uploads on local disk
# - r2: use Cloudflare R2 when R2 envs are present
# MEDIA_STORAGE_PROVIDER=local

# Cloudflare R2 (new uploads). Old Blob URLs continue to work as-is.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public base URL (custom domain or r2.dev domain) for serving media links.
# R2_PUBLIC_BASE_URL=

# Email (Resend) — bật khi có RESEND_API_KEY; thiếu thì Payload ghi mail ra console.
# Tạo API key tại https://resend.com/api-keys. Để gửi từ địa chỉ riêng cần verify domain
# (https://resend.com/domains); chưa verify thì chỉ dùng được onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=AI VIETNAM
